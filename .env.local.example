# ---------------------------------------------------------------------------
# Next.js app (.env.local). `npx convex dev` writes the first two for you.
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------------------
# Convex deployment environment. These are NOT read from .env.local: set each
# one on the deployment with `npx convex env set NAME value` (or in the Convex
# dashboard). Listed here so the full setup lives in one place.
# ---------------------------------------------------------------------------

# Convex Auth. Generate keys with `npx @convex-dev/auth` (it also sets
# SITE_URL), or see https://labs.convex.dev/auth/setup/manual.
#   SITE_URL=http://localhost:3000          # where the Next.js app runs
#   JWT_PRIVATE_KEY=
#   JWKS=
# Optional Google sign-in (OAuth client redirect URI:
# <CONVEX_SITE_URL>/api/auth/callback/google)
#   AUTH_GOOGLE_ID=
#   AUTH_GOOGLE_SECRET=

# Cloudflare R2 (video storage + uploads), used by @convex-dev/r2.
#   R2_BUCKET=
#   R2_ENDPOINT=                            # https://<account>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID=
#   R2_SECRET_ACCESS_KEY=
#   R2_TOKEN=

# Scripts: OpenAI writes each video's hook, narration, visual prompt and caption.
#   OPENAI_API_KEY=
#   OPENAI_MODEL=gpt-4.1-mini              # optional override

# Renders: MuAPI text-to-video (Veo 3.1, Sora 2, Seedance 2.0, Kling).
#   MUAPI_API_KEY=

# Auto-posting + analytics: Ayrshare (Business plan, for per-user profiles).
#   AYRSHARE_API_KEY=
#   AYRSHARE_DOMAIN=                        # from Ayrshare's JWT/linking setup
#   AYRSHARE_PRIVATE_KEY=                   # PEM, newlines as \n

# Credit packs: Stripe Checkout. Webhook endpoint:
# <CONVEX_SITE_URL>/webhooks/stripe, event checkout.session.completed.
#   STRIPE_SECRET_KEY=
#   STRIPE_WEBHOOK_SECRET=
